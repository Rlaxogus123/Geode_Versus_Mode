{
  "geode": "6.0.0",
  "gd": {
    "win": "2.2091",
    "android": "2.2091",
    "mac": "2.2091",
    "ios": "2.2091"
  },
  "id": "tipp7.versus",
  "name": "Versus",
  "version": "v1.1.0",
  "developer": "Tipp7",
  "description": "Create Classic 1 vs 1 or Group (up to 30 players) Versus rooms with custom rules, ready up, and compete on the same level!",
  "dependencies": {
    "geode.node-ids": ">=v1.22.0",
    "dankmeme.argon": ">=v2.0.0-beta.1",
    "eclipse.eclipse-menu": {
      "version": ">=v1.9.4",
      "required": false
    },
    "firee.prism": {
      "version": ">=v1.10.9",
      "required": false
    }
  },
  "resources": {
    "files": [
      "resources/sounds/*.ogg",
      "resources/auras/*.png",
      "resources/art/*.png",
      "resources/licenses/*"
    ]
  },
  "settings": {
    "firebase-api-key": {
      "type": "string",
      "name": "Server API Key",
      "description": "Firebase Web API key for the Versus server. Anonymous sign-in must be enabled in Firebase Authentication.",
      "default": "AIzaSyD1yoiFEhGa0oFm6XCzJ9DgRXs92UIvzpY"
    }
  }
}
